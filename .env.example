# Google Maps Platform API key for Google Street View metadata lookups (click-only provider).
# Enable the Street View Static API for this key. Imagery is never rendered in-app.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Apple Maps token for MapKit JS Look Around preview embed (click-only provider).
# Create a domain-restricted Maps token in Apple Developer → Certificates → Services → Maps.
# Without this token, Look Around is link-out only via maps.apple.com/look-around.
VITE_APPLE_MAPKIT_TOKEN=
