{
  "name": "street-level-imagery-provider-overview",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "FORCE_COLOR=1 bun --bun vite dev",
    "build": "FORCE_COLOR=1 bun --bun vite build",
    "preview": "FORCE_COLOR=1 bun --bun vite preview",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "oxfmt --write -c oxfmt.config.mjs .",
    "format-check": "oxfmt --check -c oxfmt.config.mjs .",
    "test-run": "vitest run --passWithNoTests src",
    "check": "bun run --parallel type-check lint format test-run",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@osm-editor-kit/street-imagery": "0.1.0-alpha.8",
    "@osm-editor-kit/street-imagery-react": "0.1.0-alpha.9",
    "@panoramax/web-viewer": "^5.3.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/cubemap-adapter": "^5.15.1",
    "@photo-sphere-viewer/cubemap-tiles-adapter": "^5.15.1",
    "@photo-sphere-viewer/equirectangular-tiles-adapter": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.15.1",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "date-fns": "^4.4.0",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^6.11.2",
    "pbf": "^5.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "tailwind-merge": "^3.7.0",
    "three": "^0.179.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.41",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript-darwin-arm64": "^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "browserslist": "^4.29.1",
    "browserslist-to-esbuild": "^2.1.1",
    "bun-types": "^1.4.2",
    "eslint-plugin-compat": "^7.0.2",
    "jsdom": "^27.4.0",
    "oxc-transform-react": "^0.148.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "@typescript/typescript-linux-x64": "^7.0.2"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not op_mini all",
    "not kaios > 0"
  ],
  "trustedDependencies": [
    "eslint-plugin-compat"
  ]
